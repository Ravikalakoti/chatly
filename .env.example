# Copy to .env and export these (or set them in Render's dashboard).
# Locally none of them are required: DEBUG defaults to True and SQLite is used.

DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated extra hosts (Render's own hostname is added automatically)
ALLOWED_HOSTS=
# Only needed for a custom domain, e.g. https://chat.example.com
CSRF_TRUSTED_ORIGINS=
# Postgres connection string. Leave empty to use SQLite.
DATABASE_URL=
# Optional: Redis for running more than one server instance
REDIS_URL=
# Country code added to phone numbers typed without one
DEFAULT_COUNTRY_CODE=91
